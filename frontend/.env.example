# Vite development server only. No model credentials belong in this file.
FRONTEND_PORT=5198
API_PROXY_TARGET=http://127.0.0.1:8098
# Browser API prefix; keep same-origin proxy unless the API enables CORS.
VITE_API_BASE_URL=/api
# 行内平台目录（空 = 同源 /web 走代理）。行外模式的本地虚拟目录地址。
VITE_AGENT_PLATFORM_ORIGIN=
VITE_ABCCLAW_PLATFORM_ORIGIN=
VITE_LOCAL_PLATFORM_ORIGIN=http://127.0.0.1:8119
